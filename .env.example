# Google Cloud & Discovery Engine AlphaEvolve Configuration
PROJECT_ID="your-gcp-project-id"
LOCATION="global"
COLLECTION="default_collection"
ENGINE_ID="alpha-evolve-experiment-engine"
ASSISTANT_ID="default_assistant"

# Service Account (for impersonation or explicit execution)
SERVICE_ACCOUNT_EMAIL="alpha-evolve-client@your-gcp-project-id.iam.gserviceaccount.com"

# Storage Bucket for evolution checkpoints & artifacts
BUCKET_NAME="alpha-evolve-experiments"

# Offline / Local Simulation Mode (set to "true" to test without GCP credentials)
MOCK_ALPHAEVOLVE="false"
